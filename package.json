{
  "name": "chatmux",
  "version": "1.0.0",
  "description": "聊天式终端多路复用器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"cd server && node index.js\" \"cd client && npx vite --host\"",
    "server": "cd server && node index.js",
    "client": "cd client && npx vite --host",
    "electron": "electron .",
    "electron:dev": "cd client && npx vite build && cd .. && electron .",
    "electron:build": "cd client && npx vite build && cd .. && electron-builder --win portable --config.win.signAndEditExecutable=false",
    "postinstall": ""
  },
  "dependencies": {
    "express": "^4.18.0",
    "multer": "^2.1.1",
    "node-pty": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chatmux.app",
    "productName": "ChatMux",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "server/**"
    ],
    "files": [
      "electron/**",
      "server/**",
      "client/dist/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": null
    },
    "extraResources": []
  }
}
